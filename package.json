{
  "name": "otiside",
  "version": "1.9.3",
  "description": "AI-assisted Arduino and breadboard designer with visual wiring, code generation, and Electron desktop support",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:icons": "node scripts/ensure-icons.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/run-electron-command.cjs . --dev\"",
    "electron:build": "npm run build:icons && vite build && electron-builder --publish never",
    "desktop:dev": "npm run electron:dev",
    "desktop:build": "npm run electron:build",
    "start": "vite",
    "release": "npm run build:icons && vite build && electron-builder --publish always",
    "website:prepare": "node scripts/prepare-website.cjs",
    "website:build": "npm run electron:build && npm run website:prepare"
  },
  "keywords": [
    "arduino",
    "breadboard",
    "circuit",
    "electron",
    "react",
    "simulator"
  ],
  "author": "otis21",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22507260/OtisIDE.git"
  },
  "bugs": {
    "url": "https://github.com/22507260/OtisIDE/issues"
  },
  "homepage": "https://github.com/22507260/OtisIDE#readme",
  "funding": {
    "type": "Buy Me a Coffee",
    "url": "https://buymeacoffee.com/otis21"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "build": {
    "appId": "com.otis21.otiside",
    "productName": "OtisIDE",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Arduino devre tasarimi ve simulasyonu",
      "description": "OtisIDE, breadboard uzerinde devre kurmayi, Arduino kodu yazmayi ve simule etmeyi tek pencerede toplar.",
      "desktop": {
        "entry": {
          "Name": "OtisIDE",
          "Categories": "Development;Electronics;IDE;"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OtisIDE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "22507260",
        "repo": "OtisIDE",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "konva": "^10.2.1",
    "monaco-editor": "^0.55.1",
    "openai": "^6.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.12"
  }
}
